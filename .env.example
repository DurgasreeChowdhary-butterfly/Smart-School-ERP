# Copy to .env and fill in real values. NEVER commit .env.
# Used by docker-compose and by the backend (which reads ../.env and backend/.env).

# --- application -------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
DEBUG=false
# Set false in production unless the docs are protected.
API_DOCS_ENABLED=true
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true in production for log aggregation; false gives readable console logs.
LOG_JSON=false

# Comma-separated list of allowed browser origins. Wildcards are rejected.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- database ----------------------------------------------------------------
# Use 127.0.0.1 rather than "localhost": the port is bound to IPv4 loopback only and
# resolving "localhost" to ::1 first can stall connections on some hosts.
# Use 127.0.0.1 rather than "localhost": the port is published on IPv4 loopback only, and
# resolving "localhost" to ::1 first can stall connections on some hosts (seen on Windows).
# docker-compose overrides POSTGRES_HOST to "db" inside the backend container.
POSTGRES_HOST=127.0.0.1
# Change the host port if 5432 is already used by another local PostgreSQL.
POSTGRES_PORT=5432
POSTGRES_USER=smart_school
# Generate a strong value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(24))"`).
# Production startup refuses placeholder passwords.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smart_school

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
DB_ECHO=false

# --- security: keys ------------------------------------------------------------
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required (>= 32 chars, non-placeholder) in staging/production. If unset in
# development, random ephemeral keys are used (sessions end on restart).
# SECRET_KEY: HMAC key for OTP codes and login-identifier fingerprints.
SECRET_KEY=change-me
# JWT_SECRET_KEY: signs access tokens. Rotating it signs everyone out.
JWT_SECRET_KEY=change-me

# --- security: tokens and sessions --------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Absolute session lifetime; refresh-token rotation cannot extend a session beyond it.
SESSION_MAX_AGE_DAYS=30

# --- security: passwords --------------------------------------------------------------
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
# Argon2id cost. Production requires ARGON2_MEMORY_COST_KIB >= 19456.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# --- security: login throttling ------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_IP=50

# --- security: OTP (mobile sign-in) ---------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=30
# disabled            -> OTP sign-in returns 503 (default; no SMS provider yet)
# development_console -> DEVELOPMENT STUB: codes are written to the app log.
#                        Rejected at startup in staging/production.
OTP_DELIVERY_BACKEND=disabled

# Database used by the test-suite (created automatically; name must end in "_test").
TEST_POSTGRES_DB=smart_school_test

# --- local ports ---------------------------------------------------------------
BACKEND_PORT=8000
